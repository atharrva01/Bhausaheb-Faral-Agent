# Database (Neon in production; local Docker Postgres in dev)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=   # same client id, used by the JS SDK

# Owner dashboard (simple demo auth)
OWNER_PASSWORD=
SESSION_SECRET=                 # long random string, e.g. `openssl rand -hex 32`

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
